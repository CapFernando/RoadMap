.env
config.js
config.js.*

# Local Netlify folder
.netlify

# Estado local do Wrangler
cloudflare-worker/.wrangler

# O dado mora no repositorio PRIVADO RoadMap-dados. Este repo e publico (GitHub
# Pages) e servia o JSON como arquivo estatico — a base inteira ficava legivel
# por qualquer pessoa com a URL, inclusive por raw.githubusercontent.
data/melhorias.json
data/*.bak

# Rascunhos do ticket de suporte: citam o SHA exato do objeto orfao que ainda
# guarda a base vazada. Num repo PUBLICO isso seria um mapa para o dado.
resposta-ticket-github.md

# O repositorio nao tem dependencia: `scripts-orfas.js` pede o parser com
# `npm i --no-save acorn acorn-walk`, e a pasta e descartavel. Sem esta linha
# ela aparece em todo `git status` de quem roda a varredura.
node_modules/

# Previas montadas a partir do codigo real das telas, para ver um componente
# funcionando sem precisar da senha do admin. Ficam DENTRO do repositorio
# porque o painel de previa nao executa script de arquivo fora da pasta do
# projeto — ele renderiza como imagem estatica, e ai nada clica.
.previa/
